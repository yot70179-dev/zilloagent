# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production). Defaults to SQLite when unset.
DATABASE_URL=postgresql://user:password@localhost:5432/zilloagent

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Zillow / Bridge Data Output ─────────────────────────────────────────────
# Sign up at https://bridgedataoutput.com
ZILLOW_API_KEY=your_bridge_data_output_api_key
ZILLOW_DATASET=your_dataset_id          # e.g. "test" or your org dataset
ZILLOW_API_BASE_URL=https://api.bridgedataoutput.com/api/v2

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
# https://twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567        # Your Twilio phone number

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
# https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=outreach@yourdomain.com

# ─── App settings ─────────────────────────────────────────────────────────────
DAILY_MESSAGE_LIMIT=250                 # Hard cap; never exceed this
CORS_ORIGINS=http://localhost:3000      # Frontend origin(s), comma-separated

# ─── Marketing agent (landing-page outreach) ──────────────────────────────────
MK_ENABLED=true                         # master switch for the marketing scheduler
MK_IL_DAILY_CAP=15                      # WhatsApp messages/day to Israeli owners
MK_US_DAILY_CAP=5                       # WhatsApp messages/day to US owners  (15+5 = 20/day)
MK_AUTO_REPLY=true                      # AI replies to inbound messages automatically
MK_MAX_AUTO_REPLIES=4                   # after this many auto-replies, hand off to you
MK_PUBLIC_URL=                          # your public app URL, e.g. https://xxx.up.railway.app
                                        # (used to build the landing-page link sent to prospects)
MK_IL_TZ=Asia/Jerusalem
MK_US_TZ=America/New_York
MK_SENDER_NAME=יותם                      # your name — used in the message ("שמי יותם...")
MK_REPORT_EMAIL=you@example.com         # where daily batch + reply alerts + monthly report go
MK_INBOX_CSV=prospects_inbox.csv        # optional: drop new prospects here to auto-import
MK_MODEL=claude-sonnet-4-20250514
MK_SENDER_NAME_EN=Yotam                 # your name in English (US segment)

# Auto-sourcing new business numbers daily via the OFFICIAL Google Places API.
# Returns numbers a business PUBLISHED for contact (for a solo business, usually
# the owner's mobile). Leave GOOGLE_PLACES_API_KEY empty to disable auto-sourcing
# and add prospects manually / via CSV instead.
GOOGLE_PLACES_API_KEY=                   # https://console.cloud.google.com → Places API
MK_SOURCE_DAILY_MAX=40                    # max new numbers to import per day
# ';'-separated "segment|search query":
MK_SOURCE_QUERIES=IL|מספרות בתל אביב;IL|מוסכים בחיפה;US|plumbers in Austin TX

# WhatsApp: leave EMPTY for safe manual mode (agent emails you wa.me links to send by
# hand — no account-ban risk). Fill these ONLY with an OFFICIAL Meta Cloud API app to
# let the agent auto-send. https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=                         # Meta permanent access token
WHATSAPP_PHONE_ID=                      # Cloud API phone-number ID
WHATSAPP_VERIFY_TOKEN=                  # any string; set the same one in Meta webhook config
WHATSAPP_TEMPLATE_NAME=                 # approved template for cold first-contact
WHATSAPP_TEMPLATE_FOLLOWUP1=            # approved template for follow-up #1 (day 3)
WHATSAPP_TEMPLATE_FOLLOWUP2=            # approved template for follow-up #2 (day 7)
WHATSAPP_TEMPLATE_LANG_HE=he            # template language code for Hebrew
WHATSAPP_TEMPLATE_LANG_EN=en_US         # template language code for English

# Follow-up cadence (auto). Total daily WhatsApp stays inside the caps above —
# follow-ups get priority, then new prospects fill the rest.
MK_FOLLOWUP1_DAYS=3                      # days after first contact -> follow-up #1
MK_FOLLOWUP2_DAYS=4                      # days after follow-up #1 -> follow-up #2
MK_MAX_FOLLOWUPS=2                       # stop after this many follow-ups
