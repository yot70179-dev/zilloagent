# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (production). Defaults to SQLite when unset.
DATABASE_URL=postgresql://user:password@localhost:5432/zilloagent

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Zillow / Bridge Data Output ─────────────────────────────────────────────
# Sign up at https://bridgedataoutput.com
ZILLOW_API_KEY=your_bridge_data_output_api_key
ZILLOW_DATASET=your_dataset_id          # e.g. "test" or your org dataset
ZILLOW_API_BASE_URL=https://api.bridgedataoutput.com/api/v2

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
# https://twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567        # Your Twilio phone number

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
# https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=outreach@yourdomain.com

# ─── App settings ─────────────────────────────────────────────────────────────
DAILY_MESSAGE_LIMIT=250                 # Hard cap; never exceed this
CORS_ORIGINS=http://localhost:3000      # Frontend origin(s), comma-separated
